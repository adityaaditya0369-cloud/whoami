{
  "items": [
    {
      "id": "expense",
      "type": "SP",
      "name": "Expense Portal",
      "entityId": "https://expenses.northwind.example",
      "active": true,
      "virtualIdentities": [],
      "credentials": {
        "signingSettings": {
          "signingKeyPairRef": {
            "id": "pfsigning2026"
          },
          "algorithm": "SHA256withRSA"
        }
      },
      "spBrowserSso": {
        "protocol": "SAML20",
        "enabledProfiles": [
          "IDP_INITIATED_SSO",
          "SP_INITIATED_SSO"
        ],
        "signAssertions": true,
        "ssoServiceEndpoints": [
          {
            "binding": "POST",
            "url": "https://expenses.northwind.example/saml/acs",
            "index": 0,
            "isDefault": true
          }
        ],
        "sloServiceEndpoints": [],
        "attributeContract": {
          "coreAttributes": [
            {
              "name": "SAML_SUBJECT",
              "nameFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified"
            }
          ],
          "extendedAttributes": [
            {
              "name": "email",
              "nameFormat": "urn:oasis:names:tc:SAML:2.0:attrname-format:basic"
            }
          ]
        },
        "adapterMappings": [
          {
            "idpAdapterRef": {
              "id": "HTMLFormAD"
            },
            "attributeContractFulfillment": {
              "SAML_SUBJECT": {
                "source": {
                  "type": "LDAP_DATA_STORE"
                },
                "value": "SAML_SUBJECT"
              },
              "email": {
                "source": {
                  "type": "LDAP_DATA_STORE"
                },
                "value": "email"
              }
            },
            "issuanceCriteria": {
              "conditionalCriteria": [
                {
                  "source": {
                    "type": "LDAP_DATA_STORE"
                  },
                  "attributeName": "memberOf",
                  "condition": "MULTIVALUE_CONTAINS_DN",
                  "value": "CN=App Users,OU=Groups,DC=northwind,DC=example"
                }
              ]
            }
          }
        ]
      }
    },
