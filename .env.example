# Copy to .env and fill in. Never commit .env.
FLASK_SECRET_KEY=change-me-to-a-long-random-string
CUSTOMER_NAME=Customer Name
# DATABASE_URL=sqlite:///data/factory.db

# --- Source: "file" (offline export folder) or "live" (Okta API) ---------
OKTA_SOURCE=file
OKTA_EXPORT_DIR=data/exports/sample-tenant

# --- Live mode ---------------------------------------------------------------
# OKTA_ORG_URL=https://customer.okta.com
# Recommended: OAuth 2.0 service app with private_key_jwt, read-only scopes
# OKTA_AUTH_MODE=oauth
# OKTA_CLIENT_ID=0oa...
# OKTA_PRIVATE_KEY_PATH=secrets/okta_service_app.pem
# OKTA_PRIVATE_KEY_KID=
# OKTA_SCOPES=okta.apps.read okta.groups.read okta.users.read okta.logs.read
#   + for the strategy pack's tenant objects: okta.policies.read okta.authenticators.read okta.authorizationServers.read
#     okta.inlineHooks.read okta.eventHooks.read okta.idps.read okta.networkZones.read
# Alternative for a pilot: API token created by a Read-Only Administrator
# OKTA_AUTH_MODE=ssws
# OKTA_API_TOKEN=

# --- Data handling / thresholds ------------------------------------------
STORE_USER_DETAILS=true
CERT_EXPIRY_WARNING_DAYS=90

# --- PingFederate target --------------------------------------------------
# AD or PINGDIRECTORY: the LDAP directory PingFederate will use as its data store
PF_DIRECTORY_TYPE=AD
# Set true only if the customer permits OGNL expressions in PingFederate
PF_OGNL_ALLOWED=false
# Optional JSON {"oktaAttribute": "ldapAttribute"} to override the default attribute map
# PF_ATTRIBUTE_MAP_FILE=config/attribute_map.json

# PingFederate values shown in the comparison report (SSO/SLO/metadata URLs, issuer)
PF_BASE_URL=https://sso.example.com
PF_ENTITY_ID=https://sso.example.com

# --- Sprint 2: risk + assessment -----------------------------------------------
# Optional JSON to override complexity weights, e.g. {"CATALOG_APP_PARTIAL_CONFIG": 3}
# RISK_WEIGHTS_FILE=config/risk_weights.json
# offline = template engine, nothing leaves this machine; anthropic = Claude
AI_PROVIDER=offline
# ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Replace hostnames/URLs, group names and app names with tokens before sending to Claude
AI_MASK_DATA=false

# --- PingFederate read-only source (what is actually built) ---------------
# none = plan only; file = export folder; live = Admin API (GET only)
PF_SOURCE=file
PF_EXPORT_DIR=data/pf-exports/sample-pf
# PF_ADMIN_URL=https://pingfed-admin.customer.com:9999/pf-admin-api/v1
# PF_ADMIN_USER=migration-auditor          # admin account with the read-only Auditor role
# PF_ADMIN_PASSWORD=
# PF_CA_BUNDLE=secrets/pf-admin-ca.pem     # if the admin console uses a private CA

# --- Usage analysis (Okta System Log; needs okta.logs.read) ----------------
OKTA_USAGE_ENABLED=true
OKTA_USAGE_DAYS=90

# --- Pipeline: agents, knowledge base, approval ----------------------------------
KNOWLEDGE_MAX_UPLOAD_MB=10
# Plan approver must be a different person from the submitter
APPROVAL_FOUR_EYES=true

# --- Gated PingFederate write (off by default) ------------------------------------
# Create-only: POST /idp/spConnections, created DISABLED, after an approved plan and a fresh dry run.
# Uses a SEPARATE admin account from the read-only auditor above. Needs PF_SOURCE=live.
PF_WRITE_ENABLED=false
# PF_WRITE_USER=migration-writer
# PF_WRITE_PASSWORD=
# JSON {"VARIABLE": {"description": "...", "value": "..."}} filling the {{VARIABLES}} in the payload
# PF_VARIABLES_FILE=config/pf-variables.json
PF_DRY_RUN_VALID_MINUTES=30

# --- SAML validation --------------------------------------------------------------
# PingFederate signing certificate (PEM). REQUIRED for pre/post-cutover validation to open the go/no-go gate;
# without it signatures are not verified and the result is FAIL. A pasted certificate only gives a quick check.
# PF_SIGNING_CERT_FILE=secrets/pf-signing.crt
VALIDATION_MAX_AGE_DAYS=14
VALIDATION_CLOCK_SKEW_SECONDS=180

# --- Optional automated test sign-in (pip install -r requirements-optional.txt) --------
# Signs a test user in through PingFederate in a headless browser and captures the response.
TEST_SSO_ENABLED=false
# TEST_SSO_USERNAME=svc-migration-test      # a test account WITHOUT MFA, never a real user
# TEST_SSO_PASSWORD=
# TEST_SSO_START_URL={pf_base_url}/idp/startSSO.ping?PartnerSpId={entity_id}

# --- Strategy pack -----------------------------------------------------------------------
# Read tenant-level objects (policies, MFA, group rules, authorization servers, hooks, IdPs, zones)
OKTA_TENANT_ENABLED=true
# Optional JSON list of catalog rows to override/extend (e.g. after an architect review)
# CAPABILITY_CATALOG_FILE=config/capability-catalog.json
